+    def _v69_get(table, mid):
+        """Entry of a per-molecule dict whose keys may be str or not (BASE, PC)."""
+        if mid in table:
+            return table[mid]
+        return next((v for k, v in table.items() if str(k) == mid), None)
+
+    def _v69_finite(value):
+        try:
+            return value is not None and math.isfinite(float(value))
+        except (TypeError, ValueError):
+            return False
+
+    def _v69_complete_group_ice(candidates, keys, formulas, ice, gl):
+        """flexonafft v86: ICEBERG scores only for same-formula groups (>= 2 rows) whose every row has a finite ICEBERG and GLACIER score."""
+        groups = {}
+        for i, formula in enumerate(formulas):
+            groups.setdefault(formula, []).append(i)
+        accepted, n_groups = {}, 0
+        for indices in groups.values():
+            if len(indices) < 2:
+                continue
+            values = []
+            for i in indices:
+                a, b = ice.get(candidates[i]), gl.get(candidates[i])
+                if a is None:
+                    a = ice.get(keys[i])
+                if b is None:
+                    b = gl.get(keys[i])
+                if not _v69_finite(a) or not _v69_finite(b):
+                    break
+                values.append(float(a))
+            else:
+                n_groups += 1
+                accepted.update((candidates[i], v) for i, v in zip(indices, values))
+        return accepted, n_groups
+
+    def _v69_post(scope, mid, result, audit, v69, stat):
+        """Library shield (lib_max >= LIB_TAU: the row that led before the engine fusion stays first) and promoted row first
+        (lib_max < LIB_TAU and the popularity branch of the merge cell fired: its PubChem row leads the final list)."""
+        ident = scope['metric_identity']
+        b = _v69_get(scope['BASE'], mid)
+        if v69.get('shield') and audit['branch'] not in ('placeholder', 'no_engine'):
+            pf = [s for s in scope['PREFUSION_LISTS'].get(mid, []) if s and s != 'CCO']
+            if b is not None and b[2] >= scope['LIB_TAU'] and pf and result and result[0] != pf[0]:
+                id0 = ident(pf[0])
+                if id0 is not None:
+                    result = ([pf[0]] + [x for x in result if ident(x) != id0])[:25]
+                    stat['shield_rows'] += 1
+        if v69.get('prom'):
+            p = _v69_get(scope['PC'], mid)
+            if p and p.get('pc') and (b[2] if b is not None else 0.0) < scope['LIB_TAU']:
+                S, pop_top = p.get('S'), float(p.get('top_pop') or 0.0)
+                if S is not None and float(S) > scope['S_TAU'] and pop_top >= scope['POP_TAU']:
+                    top = p['pc'][0]
+                    id0 = ident(top)
+                    if id0 is not None and result and ident(result[0]) != id0:
+                        result = ([top] + [x for x in result if ident(x) != id0])[:25]
+                        stat['prom_rows'] += 1
+        return result
